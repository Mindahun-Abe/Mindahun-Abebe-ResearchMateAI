# GEMINI_API_KEY: Required for server-side Gemini AI screening & chat calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run service URL used for callbacks and payment return redirects.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) connection variables (injected automatically in AI Studio Cloud SQL setups)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Chapa Hosted Checkout & Webhook Verification (Server-side only)
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""

# Telebirr Merchant Integration (Server-side only, optional)
TELEBIRR_APP_ID=""
TELEBIRR_APP_KEY=""
TELEBIRR_MERCHANT_CODE=""
TELEBIRR_PRIVATE_KEY=""

# Google Play Billing Developer API Service Account JSON (Server-side only, optional for Android Play verification)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
